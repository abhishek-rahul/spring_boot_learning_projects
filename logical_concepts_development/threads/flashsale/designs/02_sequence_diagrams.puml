@startuml CatalogLookup_HappyPath
title Catalog Lookup - Happy Path

actor Client
participant "ApiController" as Controller
participant "StartupGate" as Gate
participant "CatalogService" as Catalog

Client -> Controller: GET /api/catalog/{sku}
Controller -> Gate: awaitReady()
Gate --> Controller: Ready
Controller -> Catalog: getSkuInfo(sku)
activate Catalog

Catalog -> Catalog: rw.readLock().lock()
Catalog -> Catalog: cache.getOrDefault(sku, "UNKNOWN_SKU")
Catalog -> Catalog: rw.readLock().unlock()
Catalog --> Controller: String (SKU description)
deactivate Catalog

Controller --> Client: 200 OK (SKU description)
@enduml

