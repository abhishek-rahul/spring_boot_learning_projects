@startuml LoadTest_HappyPath
title Load Test - Happy Path

actor Tester
participant "LoadTestController" as Controller
participant "FlashSaleGate" as Gate
participant "OrderService" as Order
participant "orderExecutor\n(ThreadPool)" as OrderExec

Tester -> Controller: POST /loadtest/setup?users=10
Controller -> Gate: createBarrier(10)
activate Gate
Gate -> Gate: new CyclicBarrier(10)
Gate --> Controller: "Barrier created for users=10"
deactivate Gate
Controller --> Tester: 200 OK

Tester -> Controller: POST /loadtest/run?users=10&sku=SKU-1&qty=1
Controller -> Controller: Create 10 CompletableFuture tasks
loop For each user (i=0 to 9)
    Controller -> OrderExec: supplyAsync(() -> { gate.awaitStart(); return orderService.placeOrder(); })
    activate OrderExec
    OrderExec -> Gate: awaitStart()
    activate Gate
    note right: All 10 threads wait\non CyclicBarrier
    Gate -> Gate: await() - blocks until all 10 arrive
    Gate --> OrderExec: All threads released simultaneously
    deactivate Gate
    OrderExec -> Order: placeOrder(sku, qty)
    Order --> OrderExec: CompletableFuture<String>
    OrderExec --> Controller: Result
    deactivate OrderExec
end

Controller -> Controller: CompletableFuture.allOf(results).get(30s)
Controller -> Controller: Aggregate results (ok, oos, maint, other)
Controller --> Tester: 200 OK "DONE users=10 ok=X oos=Y maint=Z other=W"
@enduml

@startuml StartupFlow_HappyPath
title Startup Flow - Initialization

participant "ApiController\n@PostConstruct" as Controller
participant "StartupGate" as Gate
participant "CatalogService" as Catalog
participant "InventoryService" as Inventory

== Application Startup ==

Controller -> Gate: markDbReady()
activate Gate
Gate -> Gate: readyLatch.countDown() (3 -> 2)
deactivate Gate

Controller -> Catalog: updateSkuInfo("SKU-1", "FlashSale Phone")
activate Catalog
Catalog -> Catalog: rw.writeLock().lock()
Catalog -> Catalog: cache.put(sku, info)
Catalog -> Catalog: rw.writeLock().unlock()
deactivate Catalog

Controller -> Gate: markCacheReady()
activate Gate
Gate -> Gate: readyLatch.countDown() (2 -> 1)
deactivate Gate

Controller -> Inventory: seed("SKU-1", 100)
activate Inventory
Inventory -> Inventory: stock.put(sku, 100)
deactivate Inventory

Controller -> Gate: markWarmupReady()
activate Gate
Gate -> Gate: readyLatch.countDown() (1 -> 0)
note right: All startup steps complete\nAPI ready to accept requests
deactivate Gate
@enduml

@startuml EmailQueue_HappyPath
title Email Queue Processing - Background Worker

participant "OrderService" as Order
participant "EventQueueWorker" as Queue
participant "Worker Thread" as Worker
participant "Metrics" as Metrics

== Order Placement Triggers Email ==

Order -> Queue: submit(() -> sendEmailSimulated(sku, qty))
activate Queue
Queue -> Queue: queue.offer(job)
alt Queue Not Full
    Queue -> Metrics: emailsQueued.incrementAndGet()
    Queue --> Order: return true
else Queue Full
    Queue -> Metrics: emailQueueDropped.incrementAndGet()
    Queue --> Order: return false
end
deactivate Queue

== Background Worker Processing ==

Worker -> Queue: queue.take() (blocks if empty)
activate Worker
Queue --> Worker: Runnable job

Worker -> Worker: job.run() -> sendEmailSimulated()
Worker -> Worker: Thread.sleep(200ms)
Worker -> Queue: Continue polling
deactivate Worker
@enduml

@startuml DebugDeadlock_HappyPath
title Debug Deadlock - Demonstration

actor Tester
participant "DebugController" as Controller
participant "Thread-1" as T1
participant "Thread-2" as T2
participant "Object A" as A
participant "Object B" as B

Tester -> Controller: POST /debug/deadlock
Controller -> Controller: Create Thread-1 and Thread-2

== Thread-1 Execution ==
Controller -> T1: start()
activate T1
T1 -> A: synchronized(A)
activate A
T1 -> T1: sleep(50ms)
T1 -> B: synchronized(B) [BLOCKS]
note right: Waiting for Thread-2\nto release lock on B

== Thread-2 Execution ==
Controller -> T2: start()
activate T2
T2 -> B: synchronized(B)
activate B
T2 -> T2: sleep(50ms)
T2 -> A: synchronized(A) [BLOCKS]
note right: Waiting for Thread-1\nto release lock on A

== Deadlock State ==
note over T1, T2: DEADLOCK: Both threads waiting\nfor each other's locks

Controller --> Tester: 200 OK "Triggered deadlock threads. Use jstack to confirm."
@enduml

@startuml DebugDeadlockFix_HappyPath
title Debug Deadlock - Fix (Consistent Lock Ordering)

actor Tester
participant "DebugController" as Controller
participant "Thread-1" as T1
participant "Thread-2" as T2
participant "Object A" as A
participant "Object B" as B

Tester -> Controller: POST /debug/deadlock/fix
Controller -> Controller: Create Thread-1 and Thread-2\nBoth use lockInOrder(A, B)

== Thread-1 Execution ==
Controller -> T1: start()
activate T1
T1 -> A: synchronized(A)
activate A
T1 -> T1: sleep(50ms)
T1 -> B: synchronized(B)
activate B
T1 -> T1: Complete execution
deactivate B
deactivate A
deactivate T1

== Thread-2 Execution ==
Controller -> T2: start()
activate T2
T2 -> A: synchronized(A) [waits for T1 to release]
activate A
T2 -> T2: sleep(50ms)
T2 -> B: synchronized(B)
activate B
T2 -> T2: Complete execution
deactivate B
deactivate A
deactivate T2

note over T1, T2: No deadlock: Both threads\nacquire locks in same order (A then B)

Controller --> Tester: 200 OK "Deadlock fixed by consistent lock ordering (A then B)."
@enduml
