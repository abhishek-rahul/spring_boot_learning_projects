@startuml OrderPlacement_HappyPath
title Order Placement - Happy Path

actor Client
participant "ApiController" as Controller
participant "StartupGate" as Gate
participant "OrderService" as Order
participant "InventoryService" as Inventory
participant "orderExecutor\n(ThreadPool)" as OrderExec
participant "ioExecutor\n(ThreadPool)" as IOExec
participant "EventQueueWorker" as Queue
participant "Metrics" as Metrics

Client -> Controller: POST /api/orders/place?sku=SKU-1&qty=1
Controller -> Gate: awaitReady()
Gate --> Controller: Ready (CountDownLatch)
Controller -> Order: placeOrder(sku, qty)
activate Order

alt Maintenance Mode Check
    Order -> Order: check maintenanceMode
    note right: if maintenanceMode == true\nreturn "MAINTENANCE_MODE"
end

Order -> OrderExec: supplyAsync(() -> inventory.reserve())
activate OrderExec
OrderExec -> Inventory: reserve(sku, qty)
activate Inventory
Inventory -> Inventory: lock per SKU (ReentrantLock)
Inventory -> Inventory: check stock >= qty
Inventory -> Inventory: stock.put(sku, available - qty)
Inventory --> OrderExec: return true
deactivate Inventory
OrderExec --> Order: reserved = true
deactivate OrderExec

Order -> IOExec: supplyAsync(() -> paySimulated())
activate IOExec
IOExec -> IOExec: Thread.sleep(80ms)
IOExec --> Order: paymentOk = true
deactivate IOExec

Order -> Metrics: ordersPlaced.incrementAndGet()
Order -> Queue: submit(() -> sendEmailSimulated())
activate Queue
Queue -> Queue: queue.offer(job)
Queue -> Metrics: emailsQueued.incrementAndGet()
Queue -> Queue: Worker thread processes email
Queue -> Queue: Thread.sleep(200ms)
deactivate Queue

Order --> Controller: CompletableFuture<String> "ORDER_PLACED"
deactivate Order
Controller --> Client: 200 OK "ORDER_PLACED"
@enduml

@startuml OrderPlacement_OutOfStock
title Order Placement - Out of Stock Failure

actor Client
participant "ApiController" as Controller
participant "StartupGate" as Gate
participant "OrderService" as Order
participant "InventoryService" as Inventory
participant "orderExecutor\n(ThreadPool)" as OrderExec
participant "Metrics" as Metrics

Client -> Controller: POST /api/orders/place?sku=SKU-1&qty=1000
Controller -> Gate: awaitReady()
Gate --> Controller: Ready
Controller -> Order: placeOrder(sku, qty)
activate Order

Order -> Order: check maintenanceMode == false
Order -> OrderExec: supplyAsync(() -> inventory.reserve())
activate OrderExec
OrderExec -> Inventory: reserve(sku, qty)
activate Inventory
Inventory -> Inventory: lock per SKU
Inventory -> Inventory: available = stock.getOrDefault(sku, 0)
Inventory -> Inventory: if (available < qty) return false
Inventory --> OrderExec: return false
deactivate Inventory
OrderExec --> Order: reserved = false
deactivate OrderExec

Order -> Metrics: outOfStock.incrementAndGet()
Order --> Controller: CompletableFuture<String> "OUT_OF_STOCK"
deactivate Order
Controller --> Client: 200 OK "OUT_OF_STOCK"
@enduml

@startuml OrderPlacement_PaymentFailed
title Order Placement - Payment Failed

actor Client
participant "ApiController" as Controller
participant "OrderService" as Order
participant "InventoryService" as Inventory
participant "orderExecutor\n(ThreadPool)" as OrderExec
participant "ioExecutor\n(ThreadPool)" as IOExec
participant "Metrics" as Metrics

Client -> Controller: POST /api/orders/place?sku=SKU-1&qty=1
Controller -> Order: placeOrder(sku, qty)
activate Order

Order -> OrderExec: supplyAsync(() -> inventory.reserve())
activate OrderExec
OrderExec -> Inventory: reserve(sku, qty)
Inventory --> OrderExec: return true
deactivate OrderExec

Order -> IOExec: supplyAsync(() -> paySimulated())
activate IOExec
alt Payment Simulation Failure
    IOExec -> IOExec: Thread.sleep(80ms)
    IOExec -> IOExec: return false (simulated failure)
end
IOExec --> Order: paymentOk = false
deactivate IOExec

Order -> Metrics: paymentsFailed.incrementAndGet()
note right: Inventory already reserved\nbut payment failed\n(No rollback in current implementation)
Order --> Controller: CompletableFuture<String> "PAYMENT_FAILED"
deactivate Order
Controller --> Client: 200 OK "PAYMENT_FAILED"
@enduml

@startuml OrderPlacement_MaintenanceMode
title Order Placement - Maintenance Mode

