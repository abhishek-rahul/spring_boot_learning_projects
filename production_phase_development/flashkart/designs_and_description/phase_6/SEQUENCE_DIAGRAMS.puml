@startuml Catalog_GetProduct_Happy
title Get Product by ID - Happy Path

actor Client
participant "RequestIdFilter" as Filter
participant "ProductController" as Controller
participant "ProductService" as Service
participant "CacheService" as Cache
participant "ProductRepository" as Repo
database PostgreSQL
database Redis

Client -> Filter: GET /api/v1/products/{id}
activate Filter
Filter -> Filter: Generate requestId
Filter -> Controller: Forward request
deactivate Filter

activate Controller
Controller -> Service: getById(id)
activate Service

Service -> Cache: get("product:" + id, ProductResponse.class)
activate Cache
Cache -> Redis: GET catalog:product:{id}
Redis --> Cache: null (cache miss)
deactivate Cache

Service -> Repo: findByIdWithRelations(id)
activate Repo
Repo -> PostgreSQL: SELECT p.*, c.*, s.*, pr.*\nFROM products p\nLEFT JOIN categories c\nLEFT JOIN skus s\nLEFT JOIN prices pr\nWHERE p.id = ?
PostgreSQL --> Repo: Product (with relations)
deactivate Repo

Service -> Service: Map to ProductResponse
Service -> Cache: put("product:" + id, response)
activate Cache
Cache -> Redis: SET catalog:product:{id} (TTL: 1h)
deactivate Cache

Service --> Controller: ProductResponse
deactivate Service

Controller --> Client: 200 OK\n{ProductResponse}
deactivate Controller

@enduml

@startuml Catalog_SearchProducts_Happy
title Search Products - Happy Path

actor Client
participant "RequestIdFilter" as Filter
participant "ProductController" as Controller
participant "ProductService" as Service
participant "ProductRepository" as Repo
participant "ProductSpecification" as Spec
database PostgreSQL

Client -> Filter: GET /api/v1/products?\ncategoryId=&brand=&searchTerm=\npage=0&size=20&sortBy=createdAt&sortDirection=DESC
activate Filter
Filter -> Filter: Generate requestId
Filter -> Controller: Forward request
deactivate Filter

activate Controller
Controller -> Service: searchProducts(categoryId, brand, searchTerm, page, size, sortBy, sortDirection)
activate Service

Service -> Spec: buildSpecification(categoryId, brand, searchTerm)
activate Spec
Spec -> Spec: Add category filter
Spec -> Spec: Add brand filter
Spec -> Spec: Add search term (full-text search)
Spec --> Service: Specification
deactivate Spec

Service -> Service: Build Pageable
Service -> Repo: findAll(specification, pageable)
activate Repo
Repo -> PostgreSQL: SELECT p.*, c.name\nFROM products p\nJOIN categories c\nWHERE (filters)\nORDER BY sortBy sortDirection\nLIMIT size OFFSET page*size
PostgreSQL --> Repo: Page<Product>
deactivate Repo

Service -> Service: Map to ProductSummaryResponse
Service --> Controller: Page<ProductSummaryResponse>
deactivate Service

Controller -> Controller: Build PaginationMeta
Controller --> Client: 200 OK\n{Page<ProductSummaryResponse>, pagination}
deactivate Controller

