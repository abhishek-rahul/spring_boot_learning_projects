@startuml
!theme plain
skinparam sequenceMessageAlign center
skinparam maxMessageSize 60

' ============================================
' AUTHENTICATION FLOWS
' ============================================

@startuml Auth_Signup_Happy
title User Signup - Happy Path

actor Client
participant "RequestIdFilter" as Filter
participant "AuthController" as Controller
participant "AuthService" as Service
participant "UserService" as UserService
participant "UserRepository" as Repo
participant "JwtService" as Jwt
participant "RefreshTokenService" as Refresh
participant "RefreshTokenRepository" as RefreshRepo
database PostgreSQL

Client -> Filter: POST /api/v1/auth/signup\n{email, password}
activate Filter
Filter -> Filter: Generate requestId\nStore in MDC
Filter -> Controller: Forward request
deactivate Filter

activate Controller
Controller -> Controller: Validate @Valid
Controller -> Service: signup(email, password)
activate Service

Service -> Repo: existsByEmail(email)
activate Repo
Repo -> PostgreSQL: SELECT email FROM users
PostgreSQL --> Repo: false (not exists)
deactivate Repo

Service -> UserService: createUser(email, password)
activate UserService
UserService -> UserService: Hash password (BCrypt)
UserService -> Repo: save(User)
activate Repo
Repo -> PostgreSQL: INSERT INTO users
PostgreSQL --> Repo: User entity
deactivate Repo
UserService --> Service: User
deactivate UserService

Service --> Controller: User
deactivate Service

Controller -> Jwt: generateAccessToken(user)
activate Jwt
Jwt --> Controller: accessToken
deactivate Jwt

Controller -> Refresh: issueToken(user, ip, userAgent)
activate Refresh
Refresh -> Refresh: Generate token hash
Refresh -> RefreshRepo: save(RefreshToken)
activate RefreshRepo
RefreshRepo -> PostgreSQL: INSERT INTO refresh_tokens
PostgreSQL --> RefreshRepo: RefreshToken
deactivate RefreshRepo
Refresh --> Controller: refreshToken
deactivate Refresh

Controller -> Controller: Build AuthResponse
Controller --> Client: 200 OK\n{accessToken, refreshToken, user}
deactivate Controller

@enduml

@startuml Auth_Login_Happy
title User Login - Happy Path

actor Client
participant "RequestIdFilter" as Filter
participant "RateLimitFilter" as RateLimit
participant "LoginThrottleService" as Throttle
participant "AuthController" as Controller
participant "AuthService" as Service
participant "UserRepository" as Repo
participant "JwtService" as Jwt
participant "RefreshTokenService" as Refresh
database PostgreSQL
database Redis

Client -> Filter: POST /api/v1/auth/login\n{email, password}
activate Filter
Filter -> Filter: Generate requestId
Filter -> RateLimit: Check rate limit
activate RateLimit
RateLimit -> Redis: INCR rate_limit_key
Redis --> RateLimit: count
alt count > maxRequests
    RateLimit --> Client: 429 Too Many Requests
    deactivate RateLimit
    deactivate Filter
else
    RateLimit -> Controller: Continue
    deactivate RateLimit
end

Filter -> Controller: Forward request
deactivate Filter

activate Controller
Controller -> Throttle: checkAllowed(email, ip)
activate Throttle
Throttle -> Redis: GET throttle_block_key
Redis --> Throttle: null (not blocked)
deactivate Throttle

Controller -> Service: login(email, password)
activate Service

Service -> Repo: findByEmail(email)
activate Repo
Repo -> PostgreSQL: SELECT * FROM users
PostgreSQL --> Repo: User
deactivate Repo

Service -> Service: passwordEncoder.matches(password, hash)
alt Password mismatch
    Service -> Throttle: onFailure(email, ip)
    activate Throttle
    Throttle -> Redis: INCR failure_count
    deactivate Throttle
    Service --> Controller: BusinessException(INVALID_CREDENTIALS)
    Controller --> Client: 400 Bad Request
else Password matches
    Service --> Controller: User
    deactivate Service
    
    Controller -> Throttle: onSuccess(email, ip)
    activate Throttle
    Throttle -> Redis: DELETE failure_count
    deactivate Throttle
    
    Controller -> Jwt: generateAccessToken(user)
    activate Jwt
    Jwt --> Controller: accessToken
    deactivate Jwt
    
    Controller -> Refresh: issueToken(user, ip, userAgent)
    activate Refresh
    Refresh -> Refresh: Generate token hash
    Refresh -> PostgreSQL: INSERT INTO refresh_tokens
    PostgreSQL --> Refresh: RefreshToken
    Refresh --> Controller: refreshToken
    deactivate Refresh
    
    Controller --> Client: 200 OK\n{accessToken, refreshToken, user}
end
deactivate Controller

@enduml

@startuml Auth_Refresh_Happy
title Token Refresh - Happy Path

actor Client
participant "RequestIdFilter" as Filter
participant "AuthController" as Controller
participant "RefreshTokenService" as Service
participant "RefreshTokenRepository" as Repo
participant "UserRepository" as UserRepo
participant "JwtService" as Jwt
database PostgreSQL

Client -> Filter: POST /api/v1/auth/refresh\n{refreshToken}
activate Filter
Filter -> Filter: Generate requestId
Filter -> Controller: Forward request
deactivate Filter

activate Controller
Controller -> Service: rotateWithUser(refreshToken, ip, userAgent)
activate Service

Service -> Service: Hash token (SHA-256)
Service -> Repo: findByTokenHash(hash)
activate Repo
Repo -> PostgreSQL: SELECT * FROM refresh_tokens\nWHERE token_hash = ?
PostgreSQL --> Repo: RefreshToken
deactivate Repo

alt Token not found or expired or revoked
    Service --> Controller: BusinessException
    Controller --> Client: 400 Bad Request
else Token valid
    Service -> UserRepo: findById(userId)
    activate UserRepo
    UserRepo -> PostgreSQL: SELECT * FROM users WHERE id = ?
    PostgreSQL --> UserRepo: User
    deactivate UserRepo
    
    Service -> Service: Revoke old token
    Service -> Repo: save(oldToken.revoked)
    activate Repo
    Repo -> PostgreSQL: UPDATE refresh_tokens\nSET revoked_at = NOW()
    deactivate Repo
    
    Service -> Service: Issue new token
    Service -> Repo: save(newToken)
    activate Repo
    Repo -> PostgreSQL: INSERT INTO refresh_tokens
    deactivate Repo
    
    Service -> Jwt: generateAccessToken(user)
    activate Jwt
    Jwt --> Service: accessToken
    deactivate Jwt
    
    Service --> Controller: {user, newToken, accessToken}
    deactivate Service
    
    Controller --> Client: 200 OK\n{accessToken, refreshToken, user}
end
deactivate Controller

@enduml

@startuml Admin_Login_Happy
title Admin Login - Happy Path (Session-based)

actor Admin
participant "RequestIdFilter" as Filter
participant "RateLimitFilter" as RateLimit
participant "AdminAuthController" as Controller
participant "AuthenticationManager" as AuthMgr
participant "AdminUserDetailsService" as UserDetails
participant "UserRepository" as Repo
participant "SecurityContextRepository" as Session
database PostgreSQL
database Redis

Admin -> Filter: POST /api/v1/admin/auth/login\n{email, password}
activate Filter
Filter -> Filter: Generate requestId
Filter -> RateLimit: Check rate limit
activate RateLimit
RateLimit -> Redis: INCR admin_rate_limit
Redis --> RateLimit: count
alt count > maxRequests
    RateLimit --> Admin: 429 Too Many Requests
else
    RateLimit -> Controller: Continue
end
deactivate RateLimit
Filter -> Controller: Forward request
deactivate Filter

activate Controller
Controller -> AuthMgr: authenticate(UsernamePasswordAuthenticationToken)
activate AuthMgr
AuthMgr -> UserDetails: loadUserByUsername(email)
activate UserDetails
UserDetails -> Repo: findByEmail(email)
activate Repo
Repo -> PostgreSQL: SELECT * FROM users\nJOIN user_roles
PostgreSQL --> Repo: User
deactivate Repo
UserDetails -> UserDetails: Check status == ACTIVE
UserDetails --> AuthMgr: UserDetails
deactivate UserDetails
AuthMgr -> AuthMgr: Verify password
AuthMgr --> Controller: Authentication
deactivate AuthMgr

Controller -> Controller: Create SecurityContext
Controller -> Session: saveContext(context, request, response)
activate Session
Session -> Redis: SET session:key context
Redis --> Session: OK
deactivate Session

Controller --> Admin: 200 OK\n{message: "Admin login success"}
deactivate Controller

@enduml

