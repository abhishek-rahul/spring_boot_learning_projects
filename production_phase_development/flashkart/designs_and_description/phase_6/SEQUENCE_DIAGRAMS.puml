@startuml Cart_GetCart_Happy
title Get Cart - Happy Path

actor Client
participant "RequestIdFilter" as Filter
participant "CartController" as Controller
participant "CartService" as Service
participant "CartCacheService" as Cache
participant "CartRepository" as CartRepo
participant "CartItemRepository" as ItemRepo
database PostgreSQL
database Redis

Client -> Filter: GET /api/v1/carts\nAuthorization: Bearer {jwt}
activate Filter
Filter -> Filter: Generate requestId
Filter -> Controller: Forward request
deactivate Filter

activate Controller
Controller -> Controller: Extract userId from JWT
Controller -> Service: getCart(userId)
activate Service

Service -> Cache: getCart(userId, Cart.class)
activate Cache
Cache -> Redis: GET cart:{userId}
Redis --> Cache: null (cache miss)
deactivate Cache

Service -> CartRepo: findActiveCartByUserId(userId, now)
activate CartRepo
CartRepo -> PostgreSQL: SELECT * FROM carts\nWHERE user_id = ?\nAND deleted_at IS NULL\nAND expires_at > NOW()
PostgreSQL --> CartRepo: Cart
deactivate CartRepo

Service -> ItemRepo: findByCartId(cartId)
activate ItemRepo
ItemRepo -> PostgreSQL: SELECT * FROM cart_items\nWHERE cart_id = ?\nAND deleted_at IS NULL
PostgreSQL --> ItemRepo: List<CartItem>
deactivate ItemRepo

Service -> Service: Load items into cart
Service -> Cache: putCart(userId, cart)
activate Cache
Cache -> Redis: SET cart:{userId} (TTL: 1h)
deactivate Cache

Service --> Controller: Cart
deactivate Service

Controller -> Controller: Map to CartResponse
Controller --> Client: 200 OK\n{CartResponse}
deactivate Controller

@enduml

@startuml Cart_AddItem_Happy
title Add Item to Cart - Happy Path

actor Client
participant "RequestIdFilter" as Filter
participant "CartController" as Controller
participant "CartService" as Service
participant "CartCacheService" as Cache
participant "CartRepository" as CartRepo
participant "CartItemRepository" as ItemRepo
participant "SkuRepository" as SkuRepo
database PostgreSQL
database Redis

Client -> Filter: POST /api/v1/carts/items\n{skuId, quantity}
activate Filter
Filter -> Filter: Generate requestId
Filter -> Controller: Forward request
deactivate Filter

activate Controller
Controller -> Controller: Validate @Valid
Controller -> Controller: Extract userId from JWT
Controller -> Service: addItemToCart(userId, skuId, quantity)
activate Service

Service -> Service: validateQuantity(quantity)
alt quantity <= 0
    Service --> Controller: BusinessException(VALIDATION_ERROR)
    Controller --> Client: 400 Bad Request
else
    Service -> Service: getOrCreateCart(userId)
    activate Service
    Service -> Cache: getCart(userId, Cart.class)
    activate Cache
    Cache -> Redis: GET cart:{userId}
    Redis --> Cache: null
    deactivate Cache
    
    Service -> CartRepo: findActiveCartByUserId(userId, now)
    activate CartRepo
    CartRepo -> PostgreSQL: SELECT * FROM carts\nWHERE user_id = ? AND expires_at > NOW()
    PostgreSQL --> CartRepo: Cart (or empty)
    deactivate CartRepo
    
    alt Cart not found
        Service -> Service: Create new cart
        Service -> CartRepo: save(new Cart)
        activate CartRepo
        CartRepo -> PostgreSQL: INSERT INTO carts
        PostgreSQL --> CartRepo: Cart
        deactivate CartRepo
    end
    deactivate Service
    
    Service -> SkuRepo: findById(skuId)
    activate SkuRepo
    SkuRepo -> PostgreSQL: SELECT * FROM skus WHERE id = ?
    PostgreSQL --> SkuRepo: Sku
    deactivate SkuRepo
    
    Service -> Service: validateSkuAvailability(skuId, quantity)
    alt SKU not found or inactive
        Service --> Controller: NotFoundException
        Controller --> Client: 404 Not Found
    else Insufficient stock
        Service --> Controller: BusinessException(INSUFFICIENT_STOCK)
        Controller --> Client: 400 Bad Request
    else Stock available
        Service -> ItemRepo: findByCartIdAndSkuId(cartId, skuId)
        activate ItemRepo
        ItemRepo -> PostgreSQL: SELECT * FROM cart_items\nWHERE cart_id = ? AND sku_id = ?
        PostgreSQL --> ItemRepo: CartItem (or empty)
        deactivate ItemRepo
        
        alt Item exists
            Service -> Service: Update quantity
            Service -> ItemRepo: save(existingItem)
            activate ItemRepo
            ItemRepo -> PostgreSQL: UPDATE cart_items\nSET quantity = ?
            deactivate ItemRepo
        else New item
            Service -> ItemRepo: save(new CartItem)
            activate ItemRepo
            ItemRepo -> PostgreSQL: INSERT INTO cart_items
            deactivate ItemRepo
        end
        
        Service -> Service: extendCartExpiry(cart)
        Service -> CartRepo: save(cart)
        activate CartRepo
        CartRepo -> PostgreSQL: UPDATE carts\nSET expires_at = ?
        deactivate CartRepo
        
        Service -> Cache: invalidateCart(userId)
        activate Cache
        Cache -> Redis: DELETE cart:{userId}
        deactivate Cache
        
        Service --> Controller: Cart
    end
end
deactivate Service

Controller -> Controller: Map to CartResponse
Controller --> Client: 201 Created\n{CartResponse}
deactivate Controller

@enduml

@startuml Cart_CleanupJob_Happy
title Cart Cleanup Scheduled Job - Happy Path

participant "Scheduler" as Scheduler
participant "CartCleanupJob" as Job
participant "DistributedLockService" as Lock
participant "CartRepository" as Repo
database Redis
database PostgreSQL

Scheduler -> Job: @Scheduled(cron: "0 0 * * * ?")
activate Job

Job -> Lock: tryLock("cart-cleanup-job", timeout)
activate Lock
Lock -> Redis: SETNX lock:cart-cleanup-job {token} EX 600
Redis --> Lock: true (lock acquired)
Lock --> Job: lockToken
deactivate Lock

alt Lock not acquired
    Job -> Job: Log: "Lock already held"
    Job --> Scheduler: Skip execution
else Lock acquired
    Job -> Job: Log: "Starting cleanup"
    Job -> Repo: softDeleteExpiredCarts(now, now)
    activate Repo
    Repo -> PostgreSQL: UPDATE carts\nSET deleted_at = NOW()\nWHERE deleted_at IS NULL\nAND expires_at <= NOW()
    PostgreSQL --> Repo: deletedCount
    deactivate Repo
    
    Job -> Job: Log: "Deleted {count} carts"
    Job -> Lock: releaseLock("cart-cleanup-job", token)
    activate Lock
    Lock -> Redis: EVAL Lua script\n(atomic check and delete)
    Redis --> Lock: 1 (released)
    deactivate Lock
    Job --> Scheduler: Completed
end
deactivate Job

@enduml

