@startuml Auth_Login_Failure
title User Login - Failure Paths

actor Client
participant "RequestIdFilter" as Filter
participant "LoginThrottleService" as Throttle
participant "AuthController" as Controller
participant "AuthService" as Service
participant "GlobalExceptionHandler" as Handler
database Redis

Client -> Filter: POST /api/v1/auth/login\n{email, password}
Filter -> Controller: Forward request
activate Controller

Controller -> Throttle: checkAllowed(email, ip)
activate Throttle
Throttle -> Redis: GET throttle_block:{email}:{ip}
Redis --> Throttle: "1" (blocked)
deactivate Throttle

alt User is throttled
    Controller -> Handler: BusinessException(LOGIN_THROTTLED)
    activate Handler
    Handler -> Handler: Map to ApiErrorResponse
    Handler --> Client: 429 Too Many Requests\n{errorCode: "LOGIN_THROTTLED"}
    deactivate Handler
else
    Controller -> Service: login(email, password)
    activate Service
    Service -> Service: findByEmail(email)
    
    alt User not found
        Service -> Throttle: onFailure(email, ip)
        Service --> Controller: BusinessException(USER_NOT_FOUND)
        Controller -> Handler: Catch exception
        activate Handler
        Handler --> Client: 400 Bad Request\n{errorCode: "USER_NOT_FOUND"}
        deactivate Handler
    else Invalid password
        Service -> Throttle: onFailure(email, ip)
        Service --> Controller: BusinessException(INVALID_CREDENTIALS)
        Controller -> Handler: Catch exception
        activate Handler
        Handler --> Client: 400 Bad Request\n{errorCode: "INVALID_CREDENTIALS"}
        deactivate Handler
    end
    deactivate Service
end
deactivate Controller

@enduml

@startuml Cart_AddItem_Failure
title Add Item to Cart - Failure Paths

actor Client
participant "CartController" as Controller
participant "CartService" as Service
participant "SkuRepository" as SkuRepo
participant "GlobalExceptionHandler" as Handler
database PostgreSQL

Client -> Controller: POST /api/v1/carts/items\n{skuId, quantity: -1}
activate Controller

Controller -> Controller: Validate @Valid
alt Validation fails
    Controller -> Handler: MethodArgumentNotValidException
    activate Handler
    Handler --> Client: 400 Bad Request\n{errorCode: "VALIDATION_ERROR",\nerrorDetails: [{field: "quantity", message: "must be greater than 0"}]}
    deactivate Handler
else
    Controller -> Service: addItemToCart(userId, skuId, quantity)
    activate Service
    
    Service -> Service: validateQuantity(quantity)
    alt quantity <= 0
        Service --> Controller: BusinessException(VALIDATION_ERROR)
        Controller -> Handler: Catch exception
        activate Handler
        Handler --> Client: 400 Bad Request\n{errorCode: "VALIDATION_ERROR"}
        deactivate Handler
    else
        Service -> SkuRepo: findById(skuId)
        activate SkuRepo
        SkuRepo -> PostgreSQL: SELECT * FROM skus WHERE id = ?
        PostgreSQL --> SkuRepo: null
        deactivate SkuRepo
        
        alt SKU not found
            Service --> Controller: NotFoundException
            Controller -> Handler: Catch exception
            activate Handler
            Handler --> Client: 404 Not Found\n{errorCode: "NOT_FOUND"}
            deactivate Handler
        else SKU found but insufficient stock
            Service -> Service: Check availableQuantity
            Service --> Controller: BusinessException(INSUFFICIENT_STOCK)
            Controller -> Handler: Catch exception
            activate Handler
            Handler --> Client: 400 Bad Request\n{errorCode: "INSUFFICIENT_STOCK",\nerrorMessage: "Available: 5, Requested: 10"}
            deactivate Handler
        end
    end
    deactivate Service
end
deactivate Controller

@enduml

@enduml

