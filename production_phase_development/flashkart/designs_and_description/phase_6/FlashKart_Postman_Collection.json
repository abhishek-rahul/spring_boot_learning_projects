						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "auth", "login"]
						},
						"description": "Admin login using session-based authentication. Session is stored in Redis. CSRF token required for subsequent requests."
					},
					"response": []
				},
				{
					"name": "Get CSRF Token",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/csrf",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "csrf"]
						},
						"description": "Get CSRF token for admin endpoints. Use header name from response (typically X-XSRF-TOKEN)."
					},
					"response": []
				},
				{
					"name": "Get Admin Info",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "{{csrfHeaderName}}",
								"value": "{{csrfToken}}",
								"description": "CSRF token header (get from /csrf endpoint)"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "me"]
						},
						"description": "Get current admin information. Requires authenticated session and CSRF token."
					},
					"response": []
				}
			]
		},
