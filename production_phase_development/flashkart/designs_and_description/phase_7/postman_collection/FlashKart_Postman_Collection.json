						{
							"name": "Signup",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 200) {",
											"    var jsonData = pm.response.json();",
											"    if (jsonData.data && jsonData.data.tokenResponse) {",
											"        pm.environment.set('accessToken', jsonData.data.tokenResponse.accessToken);",
											"        pm.environment.set('refreshToken', jsonData.data.tokenResponse.refreshToken);",
											"        pm.environment.set('userId', jsonData.data.userResponse.id);",
											"    }",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									},
									{
										"key": "Accept",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{baseUrl}}/api/v1/auth/signup",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"api",
										"v1",
										"auth",
										"signup"
									]
								},
								"description": "User registration. Returns user info and JWT tokens (access + refresh). Tokens are automatically stored in environment variables."
