								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"cartId\": \"{{cartId}}\",\n    \"idempotencyKey\": \"checkout-{{$timestamp}}\"\n}",
							"options": {
								"raw": {
