		{
			"name": "Admin",
			"item": [
				{
					"name": "Auth",
					"item": [
						{
							"name": "Admin Login",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									},
									{
										"key": "Accept",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"admin123\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/v1/admin/auth/login",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "admin", "auth", "login"]
								},
								"description": "Admin login using session-based authentication. Creates a session stored in Redis. Note: Postman will automatically handle session cookies."
							},
							"response": []
						},
						{
							"name": "Get CSRF Token",
							"request": {
								"method": "GET",
								"header": [
									{
										"key": "Accept",
										"value": "application/json"
									}
								],
								"url": {
									"raw": "{{baseUrl}}/api/v1/admin/csrf",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "admin", "csrf"]
								},
								"description": "Get CSRF token for admin endpoints. Public endpoint. Use the token in X-XSRF-TOKEN header for subsequent requests."
							},
							"response": []
						}
					]
				},
				{
					"name": "Get Admin Info",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "X-XSRF-TOKEN",
								"value": "{{csrfToken}}",
								"description": "CSRF token (get from /csrf endpoint)"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "me"]
						},
						"description": "Get current admin user info. Requires admin session authentication and CSRF token."
					},
					"response": []
				}
			]
		}
